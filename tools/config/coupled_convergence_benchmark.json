    "bath_temperature": 3.0,
    "thermal_relaxation_rate": 0
  },

  "electrical": {
    "voltage_left": 1e-3,
    "voltage_right": 0.0
  },

  "external_heat": {
    "enabled": false,
    "amplitude": 1e-6,
    "radius_cells": 5.0
  },

  "output": {
    "directory": "benchmark_results/coupled_convergence_v3/test1e-10",
    "save_history": true,
    "make_plots": true
  }
}