{
    "simulation_config": "configs/simulations/nbn_hotspot_test.json",

    "physical_steps": 100,

    "dt_values": [
        1e-12
    ],

    "sigma_values": [
        1.0
    ],

    "order_mode": "one",

    "single_ordering": "electrical_tdgl_thermal",

    "convergence": {
        "tolerance": 1e-3,

        "max_iterations": 50,

        "check_interval": 10,

        "prediction_window": 10,

        "reasonable_iterations": 50
    },

    "adaptive_relaxation": {
        "enabled": true,

        "minimum_sigma": 0.25,

        "reduction_factor": 0.8,

        "required_reversals": 2
    },

    "adaptive_controller": {
        "enabled": true,

        "component_prediction": {
            "minimum_confidence": 0.5,

            "reasonable_iterations": 20,

            "stall_ratio": 0.999,

            "divergence_ratio": 1.0
        },

        "adaptation": {
            "electrical_tolerance_factor": 0.5,

            "tdgl_max_normalized_timestep_factor": 0.50,

            "thermal_max_substep_factor": 0.5,

            "physical_dt_factor": 0.50
        },

        "bounds": {
            "electrical_tolerance_min": 1e-15,

            "electrical_tolerance_max": 1e-5,

            "tdgl_max_normalized_timestep_min": 1e-3,

            "tdgl_max_normalized_timestep_max": 1,

            "thermal_max_substep_min": 1e-16,

            "thermal_max_substep_max": 1e-9,

            "physical_dt_min": 1e-18
        },

        "retry": {
            "max_restarts_per_timestep": 10,

            "max_total_restarts": 100
        },

        "behavior": {
            "adapt_one_component": true,

            "adapt_two_components": true,

            "reduce_dt_when_all_components_problematic": true,

            "reduce_sigma_only_for_oscillation": true,

            "retain_successful_parameters": true
        }
    },

    "initial_conditions": {
        "uniform_psi_one": true,

        "initial_tdgl_max_normalized_timestep": 0.1
    },

    "thermal": {
        "bath_temperature": 9.0,

        "thermal_relaxation_rate": 1e5
    },

    "electrical": {
        "voltage_left": 0.1,

        "voltage_right": 0.0
    },

    "external_heat": {
        "enabled": true,

        "amplitude": 1e16,

        "radius_cells": 20.0
    },

    "output": {
        "directory": "benchmark_results/coupled_convergence/test5",

        "save_history": true,

        "make_plots": true
    }
}