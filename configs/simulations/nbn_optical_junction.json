{
  "_documentation": {
    "purpose": "Two-temperature spatial TDGL film with a central resolved Josephson weak link for optical vortex experiments.",
    "relies_on": "Uses NbN_optical_junction_film.json and NbN_tdgl_reference.json.",
    "run_command": "Referenced by tools/config/optical_junction_vortex_transport.json.",
    "fields": {
      "josephson.center_x_m": "Center of the vertical weak-link strip.",
      "josephson.width_m": "Resolved weak-link width; two mesh cells here.",
      "josephson.coefficient_suppression": "Local reduction of condensate-favoring GL coefficient; larger values make a deeper weak link.",
      "time.dt": "Physical TDGL step in seconds.",
      "thermal": "Two-temperature electron-phonon model and bath relaxation controls.",
      "electrical": "Left-to-right current drive and scalar-potential solve.",
      "tdgl": "Gauge-compatible Heun TDGL integration controls."
    }
  },
  "name": "NbN optical Josephson vortex film",
  "geometry": "NbN_optical_junction_film.json",
  "material": "NbN_tdgl_reference.json",
  "temperature": 13.0,
  "current": {"value": 0.0, "units": "A"},
  "time": {"dt": 1e-14, "duration": 1e-12},
  "thermal": {
    "bath_temperature": 13.0,
    "model": "two_temperature",
    "electron_heat_capacity_fraction": 0.5,
    "electron_thermal_conductivity_fraction": 0.7,
    "electron_phonon_coupling_W_m3_K": 1e16,
    "phonon_escape_rate_per_s": 1e10,
    "max_substep": 1e-13,
    "stability_safety_factor": 0.9
  },
  "laser": {
    "enabled": false,
    "absorbed_power_W": 0.0,
    "sigma_m": 1e-08,
    "repeat_path": false,
    "waypoints": []
  },
  "pinning": {"enabled": false, "maximum_suppression": 1.0, "sites": []},
  "josephson": {
    "enabled": true,
    "center_x_m": 7.5e-08,
    "width_m": 2e-09,
    "coefficient_suppression": 0.7
  },
  "electrical": {
    "drive_mode": "current",
    "source_contact": "left_current",
    "sink_contact": "right_current",
    "reference_voltage": 0.0,
    "normal_conductivity_model": "condensate_depletion",
    "solver": {
      "backend": "sparse_direct",
      "tolerance": 1e-11,
      "max_iterations": 100000,
      "omega": 1.7,
      "residual_check_interval": 10
    }
  },
  "electromagnetic": {
    "include_self_field": false,
    "include_displacement_current": false,
    "screening_tolerance": 0.0001,
    "screening_max_iterations": 100,
    "screening_step_size": 0.3,
    "screening_source_stride": 1
  },
  "tdgl": {
    "normalization": "pytdgl",
    "temperature_model": "tc_over_t_minus_one",
    "u": 5.79,
    "gamma": 0.0,
    "kappa": 1.0,
    "include_scalar_potential": true,
    "max_normalized_timestep": 0.01,
    "stability_safety_factor": 0.8,
    "time_integrator": "heun"
  },
  "coupling": {
    "tolerance": 1e-06,
    "max_iterations": 100,
    "minimum_iterations": 1,
    "check_interval": 1,
    "prediction_window": 10,
    "reasonable_iterations": 50,
    "fast_ratio": 0.5,
    "healthy_ratio": 0.95,
    "stall_ratio": 0.999,
    "oscillation_window": 4,
    "electrical_tolerance_fraction": 0.25,
    "field_scales": {
      "temperature": 1.0,
      "psi": 1.0,
      "voltage": 0.001,
      "vector_potential_x": 1e-07,
      "vector_potential_y": 1e-07
    }
  },
  "boundaries": {
    "left": {"type": "fixed_temperature", "temperature": 13.0},
    "right": {"type": "fixed_temperature", "temperature": 13.0},
    "top": {"type": "insulating"},
    "bottom": {"type": "insulating"}
  },
  "tdgl_boundaries": {
    "left": {"type": "normal_contact_mask"},
    "right": {"type": "normal_contact_mask"},
    "top": {"type": "insulating"},
    "bottom": {"type": "insulating"}
  }
}
