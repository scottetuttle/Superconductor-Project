{
  "_documentation": {
    "purpose": "Generated Perforated ring / SQUID experiment. Review physical scales and convergence before interpretation.",
    "preset": "squid_ring",
    "runner": "tools/tdgl_diagnostics.py",
    "run_command": "python tools/tdgl_diagnostics.py --config tools/config/squid_ring_fat_experiment.json",
    "coordinate_units": "Editor nanometres were converted to SI metres."
  },
  "simulation_config": "configs/simulations/squid_ring_fat_simulation.json",
  "run": {
    "steps": 1500,
    "dt": 1.0000000000000002e-14,
    "sample_every": 5
  },
  "sweeps": {
    "diagnostics.applied_Bz_T": [
      0.5
    ],
    "diagnostics.target_current_A": [
      5e-9
    ]
  },
  "transport": {
    "drive_mode": "current",
    "target_current_A": 5e-9,
    "relative_tolerance": 0.001,
    "max_voltage_iterations": 8,
    "voltage_limit_V": 0.01
  },
  "magnetic_field": {
    "applied_Bz_T": 0.5,
    "gauge": "symmetric",
    "calculate_self_field": true,
    "observation_height_m": 5e-9,
    "source_stride": 1
  },
  "validity": {
    "maximum_distance_from_Tc": 0.2,
    "maximum_thickness_over_xi": 1,
    "maximum_thickness_over_lambda": 1,
    "maximum_spacing_over_xi": 0.5
  },
  "initial_conditions": {
    "temperature_hotspot": {
      "enabled": false
    },
    "vortices": [
      {
        "x_fraction": 0.2917933130699088,
        "y_fraction": 0.8771846504559271,
        "charge": 1,
        "core_radius_cells": 2
      },
      {
        "x_fraction": 0.790273556231003,
        "y_fraction": 0.18721504559270521,
        "charge": 1,
        "core_radius_cells": 2
      }
    ]
  },
  "vortex_detection": {
    "amplitude_floor": 1e-8
  },
  "vortex_tracking": {
    "max_displacement_cells": 8
  },
  "fluxoid": {
    "contour_inset_fraction": 0.2
  },
  "output": {
    "directory": "benchmark_results/squid_ring_fat",
    "plots": true,
    "kymograph_centerline": "horizontal",
    "dpi": 150,
    "vector_stride": 5,
    "gif": {
      "enabled": true,
      "fps": 4
    }
  }
}
